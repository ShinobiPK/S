-- ===================================================
-- ALL-IN-ONE SCRIPT FOR DUNGEON / RAID (EXTREME POTATO)
-- Features:
-- 1. Ultimate FPS Booster (ลบทุกอย่างในแมพ เหลือแค่พื้นยืน + UI)
-- 2. Anti-Freeze & Auto Rejoin (แก้ปัญหาวาร์ปค้าง / จอดำ)
-- 3. Auto Join Request (ยิงคำขอเฉพาะใน Lobby)
-- 4. Auto Sell System (ขายของ + กด YES ยืนยันอัตโนมัติ)
-- ===================================================

local TARGET_USERNAME = "viewowo"
local JOIN_INTERVAL = 5

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local Lighting = game:GetService("Lighting")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

-- ===================================================
-- 1. EXTREME FPS BOOSTER (DESTROY EVERYTHING EXCEPT FLOOR)
-- ===================================================
task.spawn(function()
    pcall(function()
        -- 1.1 ปิดแสง 3D และเอฟเฟกต์บรรยากาศทั้งหมด
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 0
        Lighting.Brightness = 0
        Lighting.ClockTime = 12
        
        for _, v in pairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
                v:Destroy()
            end
        end

        -- 1.2 ฟังก์ชันลบองค์ประกอบฉากและซ่อน Object
        local function purgeObject(obj)
            -- ข้ามการลบถ้าเป็นตัวละครผู้เล่น หรือ Camera
            if obj:IsDescendantOf(workspace:FindFirstChild("Terrain") or workspace) then
                local char = LocalPlayer.Character
                if char and obj:IsDescendantOf(char) then return end
                for _, player in pairs(Players:GetPlayers()) do
                    if player.Character and obj:IsDescendantOf(player.Character) then return end
                end
            end

            -- ลบ Texture, Decal, Light, Particle, Sound และ Visual Effect ทั้งหมด
            if obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("ParticleEmitter") or 
               obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or 
               obj:IsA("Sparkles") or obj:IsA("Light") or obj:IsA("Sound") or obj:IsA("SpecialMesh") then
                obj:Destroy()
            
            -- ปรับแต่ง BasePart ให้เป็นแค่บล็อกเรียบๆ ไม่มีสี/มิติ
            elseif obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
                obj.CastShadow = false
                
                -- ลบ Part ประดับฉากที่ไม่ใช่พื้นยืน (CanCollide = false)
                if not obj.CanCollide and obj.Name ~= "HumanoidRootPart" then
                    obj:Destroy()
                end
            end
        end

        -- เคลียร์สิ่งที่มีอยู่แล้วใน Workspace
        for _, obj in pairs(workspace:GetDescendants()) do
            purgeObject(obj)
        end

        -- ดักจับ Object ใหม่ที่โหลดเข้ามาให้โดนลบทันที
        workspace.DescendantAdded:Connect(purgeObject)
        
        -- ปิดการประมวลผล Terrain 3D
        if workspace:FindFirstChildOfClass("Terrain") then
            local terrain = workspace:FindFirstChildOfClass("Terrain")
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 0
        end

        print("[Extreme FPS] เคลียร์ฉากแมพเรียบร้อย เหลือเฉพาะพื้นยืนและ UI!")
    end)
end)

-- ===================================================
-- 2. ANTI-FREEZE & AUTO REJOIN
-- ===================================================
print("[Anti-Freeze] ระบบตรวจจับ Teleport Failed เริ่มทำงาน...")

TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
    if player == LocalPlayer then
        warn("[Anti-Freeze] การ Teleport ล้มเหลว: " .. tostring(errorMessage))
        task.wait(2)
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end
end)

task.spawn(function()
    while true do
        task.wait(12)
        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        if not gui then
            warn("[Anti-Freeze] ไม่พบ PlayerGui (ค้างหน้าจอดำ) กำลัง Rejoin...")
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
            break
        end
    end
end)

-- ===================================================
-- 3. AUTO JOIN REQUEST
-- ===================================================
task.spawn(function()
    print("[Auto Join] ระบบ Auto Join เริ่มทำงาน...")

    while true do
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local isLobby = playerGui and (playerGui:FindFirstChild("mainInterface") or playerGui:FindFirstChild("queueGui"))

        if not isLobby then
            print("[Auto Join] ย้ายเข้า Dungeon แล้ว -> หยุดยิงคำขอ!")
            break
        end

        print("[Auto Join] กำลังส่ง Request หา: " .. TARGET_USERNAME)

        local foundRemote = false
        for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local name = obj.Name:lower()
                local isJoinRemote = (name:find("request") or name:find("join")) 
                                     and not name:find("swap") 
                                     and not name:find("slot") 
                                     and not name:find("create")

                if isJoinRemote then
                    if obj:IsA("RemoteEvent") then
                        obj:FireServer(TARGET_USERNAME)
                    elseif obj:IsA("RemoteFunction") then
                        pcall(function() obj:InvokeServer(TARGET_USERNAME) end)
                    end
                    foundRemote = true
                end
            end
        end

        if not foundRemote then
            for _, gui in pairs(LocalPlayer.PlayerGui:GetDescendants()) do
                if gui:IsA("TextBox") then
                    if gui.Name:lower():find("user") or gui.PlaceholderText:lower():find("user") or gui.Parent.Name:lower():find("join") then
                        gui.Text = TARGET_USERNAME
                        local parent = gui.Parent
                        if parent then
                            for _, child in pairs(parent:GetChildren()) do
                                if child:IsA("GuiButton") and (child.Name:lower():find("send") or child.Name:lower():find("request")) then
                                    for _, conn in pairs(getconnections(child.MouseButton1Click)) do
                                        conn:Fire()
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        task.wait(JOIN_INTERVAL)
    end
end)

-- ===================================================
-- 4. AUTO SELL SYSTEM
-- ===================================================
getgenv().AutoSellActive = true

local function clickButton(btn)
    if not btn or not btn:IsA("GuiObject") then return false end
    
    local fired = false
    for _, eventName in ipairs({"MouseButton1Click", "MouseButton1Down", "Activated"}) do
        if btn[eventName] then
            for _, conn in pairs(getconnections(btn[eventName])) do
                conn:Fire()
                fired = true
            end
        end
    end
    
    if not fired and btn.AbsoluteSize.X > 0 then
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        local clickX = pos.X + (size.X / 2)
        local clickY = pos.Y + (size.Y / 2) + 36
        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 1)
        fired = true
    end
    return fired
end

local function processSell()
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return end

    -- 4.1 ถ้ามีปุ่ม YES เด้งอยู่ ให้พุ่งไปกด YES ก่อนเลยทันที
    for _, obj in ipairs(playerGui:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") or obj:IsA("Button") then
            local btnName = obj.Name:lower()
            local btnText = (obj:IsA("TextButton") and obj.Text or ""):lower()
            
            if (btnName == "yes" or btnText == "yes") and obj.AbsoluteSize.X > 0 and obj.Visible then
                print("✅ [Auto Sell] เจอปุ่ม YES! กำลังกดเพื่อยืนยัน...")
                clickButton(obj)
                task.wait(1.5)
                return
            end
        end
    end

    -- 4.2 ถ้าไม่มี YES ให้ทำงานกับ sellShop
    local sellShop = playerGui:FindFirstChild("sellShop")
    if not sellShop or not sellShop.Enabled then return end

    local rarityFrame = sellShop:FindFirstChild("rarityButtonsFrame", true)
    local sellButton = sellShop:FindFirstChild("sellButton", true)

    if rarityFrame then
        local safeRarities = {"CommonButton", "UncommonButton", "RareButton", "EpicButton"}
        for _, btnName in ipairs(safeRarities) do
            local btn = rarityFrame:FindFirstChild(btnName)
            if btn and btn.AbsoluteSize.X > 0 then
                clickButton(btn)
                task.wait(0.4)
            end
        end
    end

    -- 4.3 กดปุ่มขาย ($)
    if sellButton and sellButton.AbsoluteSize.X > 0 then
        task.wait(0.5)
        clickButton(sellButton)
        print("💰 [Auto Sell] กดปุ่มขาย ($) เรียบร้อย รอหน้าต่าง YES...")
    end
end

task.spawn(function()
    print("🟢 [Auto Sell System] เริ่มทำงานระบบขายของ...")
    while getgenv().AutoSellActive do
        pcall(function()
            processSell()
        end)
        task.wait(4)
    end
    print("🔴 [Auto Sell System] หยุดการทำงานแล้ว")
end)
